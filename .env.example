# Copy this file to .env.local for local development, and add the same variables in
# Vercel > Project > Settings > Environment Variables for production.
# Never commit real values.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public base URL, used for canonical URLs, sitemap and Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://jonaschukwuemeka.com

# WhatsApp number in international format, digits only (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER=2348069195852

# Cal.com booking link: full URL or path, e.g. "https://cal.com/jonaschukwuemeka/introcall".
# Powers the "Book a call" button in the header and the contact section.
NEXT_PUBLIC_CAL_LINK=

# Google Search Console > HTML tag verification: only the content="..." value. Optional.
GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Database (Neon serverless Postgres), used from Phase 4
# ---------------------------------------------------------------------------
# Neon dashboard > Connection details > pooled connection string.
# After setting it, create the tables once with: npm run db:migrate
DATABASE_URL=

# ---------------------------------------------------------------------------
# Email (Resend), used from Phase 4
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Where new enquiry notifications are delivered.
CONTACT_TO_EMAIL=jonas@weblanda.com
# Sender for auto-replies and newsletters. Must be on a domain verified in Resend,
# e.g. "Jonas Chukwuemeka <hello@jonaschukwuemeka.com>".
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Admin dashboard (/admin), used from Phase 6
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@jonaschukwuemeka.dev
# bcrypt hash of the admin password. Generate with: npm run hash-password
# In .env.local, every $ must be escaped as \$ (the script prints that version for you;
# quotes don't help). On Vercel, paste the plain hash without backslashes.
ADMIN_PASSWORD_HASH=
# Random string of at least 32 characters used to sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
# Random salt mixed into IP hashes for analytics and rate limiting. Raw IPs are never stored.
# Generate the same way as SESSION_SECRET, and use a different value.
IP_HASH_SALT=
